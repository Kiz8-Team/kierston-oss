#!/opt/venv/bin/python3
"""Mapped addresses and streets, in either direction."""
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

with open("/usr/local/share/adi/messages.json") as handle:
    MESSAGES = json.load(handle)

if len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help"):
    print(MESSAGES["addressUsage"])
    print(MESSAGES["addressHelp"])
    sys.exit(0)
if len(sys.argv) == 2:
    body = {"address": sys.argv[1]}
elif len(sys.argv) in (3, 4):
    try:
        body = {"latitude": float(sys.argv[1]), "longitude": float(sys.argv[2]), "radiusMetres": float(sys.argv[3]) if len(sys.argv) == 4 else 100}
    except ValueError:
        sys.stderr.write(MESSAGES["addressUsage"] + "\n")
        sys.exit(2)
else:
    sys.stderr.write(MESSAGES["addressUsage"] + "\n")
    sys.exit(2)

base_url = os.environ.get("AU", "http://host.docker.internal:8765")
url = urllib.parse.urljoin(base_url.rstrip("/") + "/", "address")
if os.environ.get("AT"):
    body["token"] = os.environ["AT"]
request = urllib.request.Request(url, json.dumps(body).encode(), {"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(request, timeout=60) as response:
        result = json.load(response)
except urllib.error.HTTPError as error:
    sys.stderr.write(MESSAGES["refused"].format(name="km_address_lookup", code=error.code, body=error.read().decode(errors="replace")))
    sys.exit(2)
except (urllib.error.URLError, OSError) as error:
    sys.stderr.write(MESSAGES["unreachable"].format(name="km_address_lookup", url=url, error=error))
    sys.exit(2)
sys.stdout.write(result["out"])
sys.stderr.write(result["err"])
sys.exit(result["code"])
