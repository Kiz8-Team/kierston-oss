# Copy to ~/.config/systemd/user/kdi.service and replace absolute paths.
[Unit]
Description=Kierston shared KDI service

[Service]
Type=exec
WorkingDirectory=/srv/kierston/kierston_bench
ExecStart=/home/bench/.bun/bin/bun run /srv/kierston/kierston_bench/agent_eval_runtime/kdi_service.ts
Environment=PATH=/home/bench/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=KDI_SERVICE_HOST=127.0.0.1
Environment=KDI_SERVICE_PORT=8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
